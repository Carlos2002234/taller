# Credenciales y configuración local (NUNCA subir)
.env
.env.*
!.env.example
*.pem
*.key

# Archivos subidos (fotos de productos) — solo se versiona la estructura
/public/uploads/productos/*
!/public/uploads/productos/.gitkeep

# Comprobantes de pago y logs (privados, NUNCA al repositorio)
/storage/comprobantes/*
!/storage/comprobantes/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Dependencias y compilados
/vendor/
/node_modules/
/public/css/*.min.css.map

# Respaldos y volcados de base de datos
*.sql.gz
/backups/
*.bak

# Logs y temporales
*.log
/tmp/

# Sistema / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
