# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub.

# Entorno: local | produccion
# En el servidor SIEMPRE "produccion": oculta errores y páginas de desarrollo aunque APP_DEBUG sea true.
APP_ENV=local
# Mostrar errores en pantalla y habilitar /instalacion y /estilos (solo en local)
APP_DEBUG=true
# URL base del sitio, sin barra al final
APP_URL=http://taller.test
APP_TIMEZONE=America/Costa_Rica

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taller
DB_USER=root
DB_PASS=

# Nombre de la cookie de sesión
SESSION_NAME=rivera_sesion
