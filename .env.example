# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub.

# Entorno: local | produccion
# En el servidor SIEMPRE "produccion": oculta errores y páginas de desarrollo aunque APP_DEBUG sea true.
APP_ENV=local
# Mostrar errores en pantalla y habilitar /instalacion y /estilos (solo en local)
APP_DEBUG=true
# URL base del sitio, sin barra al final
APP_URL=http://taller.test
APP_TIMEZONE=America/Costa_Rica

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taller
DB_USER=root
DB_PASS=

# Nombre de la cookie de sesión
SESSION_NAME=rivera_sesion

# Alertas por Telegram cuando entra una consulta (lead). Déjalos vacíos para desactivarlas.
# Cómo obtenerlos: docs/alertas-telegram.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aviso por correo cuando entra una consulta (lead), enviado desde Gmail. Vacíos = desactivado.
# GMAIL_CLAVE_APP es una "contraseña de aplicación" de 16 letras (NO la clave normal de Gmail).
# Cómo obtenerla y probarla: docs/alertas-correo.md
# Ejemplo: GMAIL_USUARIO=criverav04@gmail.com
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
# A quién llega el aviso (vacío = al mismo GMAIL_USUARIO)
AVISOS_CORREO_A=

# Microsoft Clarity (mapas de calor y grabaciones anónimas). Solo se activa con APP_ENV=produccion,
# nunca en el panel /admin ni para quien tiene sesión en el panel. Vacío = desactivado.
CLARITY_ID=

# Monitoreo (Admin → Monitoreo). Ver docs/monitoreo.md
# Dirección pública que se vigila (vacío = APP_URL)
MONITOREO_URL=
# Carpeta de respaldos diarios y su registro (vacío = el bloque Respaldos dice "Sin datos")
RESPALDOS_DIR=
RESPALDOS_LOG=
# Métricas locales de cloudflared (túnel de Cloudflare)
CLOUDFLARED_METRICS=127.0.0.1:20241
